# ==============================================================================
# 1. EJECUCIÓN Y GUARDARRAÍLES (Protección de memoria y modo de trabajo)
# ==============================================================================
APP_ENV=sandbox                     # Opción: [sandbox | staging | production]
SIMULATION_MODE=true                # true = Respuestas simuladas locales sin API externa
DRY_RUN=true                        # true = Procesa la lógica criptográfica sin ejecutar envíos
LOG_LEVEL=debug                     # Opción: [debug | info | warn | error]
MAX_MEMORY_ALLOCATION_MB=512        # Límite preventivo para evitar cierres por LMK/RAM

# ==============================================================================
# 2. ENDPOINTS Y ENRUTAMIENTO (Adaptación de llamadas en profundidad)
# ==============================================================================
API_BASE_URL=https://sandbox.api.bank.domain/v1
EIDAS_PROVIDER_URL=https://mitid-sandbox.eidas.dk/auth
TLS_CERT_PATH=./certs/sandbox_client.crt
TLS_KEY_PATH=./certs/sandbox_client.key

# ==============================================================================
# 3. SECRETOS Y CREDENCIALES (Variables sensibles / Vault)
# ==============================================================================
# En modo SIMULATION_MODE=true, el sistema usará tokens simulados si estos están vacíos
OAUTH_CLIENT_ID=sim_client_8f9a2b
OAUTH_CLIENT_SECRET=sim_sec_99a8b7c6d5e4f3a2b1
HMAC_SIGNING_KEY=sim_hmac_secret_key_32_bytes_len
SERVICE_ACCOUNT_TOKEN=mock_bearer_token_xyz
